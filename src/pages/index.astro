---
import Base from "../layouts/Base.astro";
import { byNewest, getProject } from "../data/projects";

const symbiont = getProject("symbiont")!;
const rest = byNewest.filter((p) => p.slug !== "symbiont");
---

<Base title="Oleksandr Mykhalskyi — Work" active="Work">
  <!-- ── Thesis: must land in under 30 seconds ── -->
  <section class="hero wrap">
    <p class="eyebrow">Composer · Sound artist · Live performance & biofeedback</p>
    <h1 class="display distort">
      I make sound for live bodies,<br />
      texts and rooms. Then I build<br />
      instruments where the performer<br />
      is a <span class="accent">living system</span>.
    </h1>
    <p class="lede prose">
      My work is composition and sound for performance — a fragmenting text, a
      body in a dreamscape, a collective in catastrophe. <strong>SYMBIONT</strong>
      keeps exactly that practice and swaps one performer for a living system:
      an EEG signal, a plant, a room.
    </p>
  </section>

  <!-- ── SYMBIONT (featured) ── -->
  <section class="symbiont wrap">
    <a class="s-video" href={`/work/${symbiont.slug}`} aria-label="SYMBIONT">
      <video src={symbiont.video} autoplay muted loop playsinline preload="metadata"></video>
    </a>
    <div class="s-text">
      <p class="eyebrow">{symbiont.category}</p>
      <h2 class="display distort"><a href={`/work/${symbiont.slug}`}>SYMBIONT</a></h2>
      <p class="prose">{symbiont.summary}</p>
      <a class="s-more mono" href={`/work/${symbiont.slug}`}>Open →</a>
    </div>
  </section>

  <hr class="rule wrap" style="max-width: 68rem;" />

  <!-- ── Work index, newest → oldest ── -->
  <section class="work wrap">
    <p class="eyebrow sec-eyebrow">Selected work</p>
    <ol class="index">
      {rest.map((p) => (
        <li class="row">
          <a class="row-link" href={`/work/${p.slug}`}>
            <span class="row-year mono">{p.yearLabel}</span>
            <span class="row-main">
              <span class="row-title display distort-light">{p.title}</span>
              <span class="row-summary">{p.summary}</span>
            </span>
            <span class="row-meta mono">
              <span class="row-cat">{p.category}</span>
              <span class="row-role">{p.role}</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .hero { padding-top: 3rem; padding-bottom: 3.5rem; }
  .hero .eyebrow { margin-bottom: 1.4rem; display: block; }
  .lede { margin-top: 2rem; color: var(--ink-soft); }
  .lede strong { color: var(--ink); font-weight: 400; }

  .symbiont {
    padding: 1rem 0 3rem;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .s-video { display: block; aspect-ratio: 16 / 10; background: #000; overflow: hidden; }
  .s-video video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .s-text h2 { margin: 0.6rem 0 1rem; }
  .s-text h2 a:hover { color: var(--red); }
  .s-text .prose { color: var(--ink-soft); }
  .s-more { display: inline-block; margin-top: 1rem; color: var(--red); }

  .sec-eyebrow { display: block; margin-bottom: 1.5rem; }
  .work { padding-top: 3rem; }
  .index { list-style: none; margin: 0; padding: 0; }
  .row { border-top: 1px solid var(--rule); }
  .row:last-child { border-bottom: 1px solid var(--rule); }
  .row-link {
    display: grid;
    grid-template-columns: 5rem 1fr minmax(9rem, 12rem);
    gap: 1.5rem;
    align-items: baseline;
    padding: 1.6rem 0;
    transition: background 0.15s ease;
  }
  .row-link:hover { background: #fafafa; }
  .row-link:hover .row-title { color: var(--red); }
  .row-year { color: var(--ink-faint); }
  .row-main { display: flex; flex-direction: column; gap: 0.4rem; }
  .row-title { font-size: 1.6rem; line-height: 1.05; transition: color 0.15s ease; }
  .row-summary { color: var(--ink-soft); font-size: 0.95rem; line-height: 1.45; }
  .row-meta { display: flex; flex-direction: column; gap: 0.3rem; text-align: right; }
  .row-cat { color: var(--red); }
  .row-role { color: var(--ink-faint); }

  @media (max-width: 720px) {
    .symbiont { grid-template-columns: 1fr; }
    .row-link { grid-template-columns: 1fr; gap: 0.5rem; }
    .row-meta { flex-direction: row; gap: 0.8rem; text-align: left; }
    .row-year { order: -1; }
  }
</style>
