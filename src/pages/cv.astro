---
import Base from "../layouts/Base.astro";
import { byNewest } from "../data/projects";

// Sourced from the same data as the work pages so the CV never drifts.
const work = byNewest.filter((p) => p.category === "Instrument");
const performance = byNewest.filter((p) =>
  ["Theatre", "Installation", "Performance"].includes(p.category)
);
const live = byNewest.filter((p) => p.category === "Live performance");
const events = byNewest.filter((p) => p.category === "Event");

const sections = [
  { title: "Work", items: work },
  { title: "Sound for performance", items: performance },
  { title: "Live performances", items: live },
  { title: "Events & organising", items: events },
];
---

<Base title="Oleksandr Mykhalskyi — CV" active="CV">
  <div class="cv wrap">
    <header class="cv-head">
      <p class="eyebrow">Curriculum</p>
      <h1 class="display distort">Oleksandr Mykhalskyi</h1>
      <p class="prose bio">
        Composer and sound artist from Lviv, based between Hamburg and Gießen.
        Makes sound for performance, theatre and installation, performs live as
        Magdeburg 96, and builds instruments where the performer is a living
        system.
      </p>
    </header>

    {sections.map((sec) => (
      <section class="cv-sec">
        <h2 class="mono sec-title">{sec.title}</h2>
        <dl class="entries">
          {sec.items.map((e) => (
            <div class="entry">
              <dt class="mono year">{e.yearLabel}</dt>
              <dd>
                <a class="e-title display distort-light" href={`/work/${e.slug}`}>{e.title}</a>
                <span class="e-role mono">{e.role}</span>
                <span class="e-note">{e.summary}</span>
                {e.todo && <span class="e-todo mono">to confirm — {e.todo}</span>}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    ))}

    <p class="contact mono">
      <a href="https://instagram.com/oooohshitdawg">@oooohshitdawg</a>
    </p>
  </div>
</Base>

<style>
  .cv { padding-top: 3rem; padding-bottom: 4rem; }
  .cv-head { margin-bottom: 3.5rem; }
  .cv-head .eyebrow { display: block; margin-bottom: 1.2rem; }
  .bio { margin-top: 1.6rem; color: var(--ink-soft); max-width: 42rem; }

  .cv-sec { margin-bottom: 3rem; }
  .sec-title {
    color: var(--red);
    letter-spacing: 0.22em;
    margin: 0 0 1.2rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--rule);
  }
  .entries { margin: 0; }
  .entry {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1.5rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .year { color: var(--ink-faint); padding-top: 0.35rem; }
  .entry dd { margin: 0; display: flex; flex-direction: column; gap: 0.35rem; }
  .e-title { font-size: 1.5rem; line-height: 1.1; width: fit-content; }
  .e-title:hover { color: var(--red); }
  .e-role { color: var(--red); }
  .e-note { color: var(--ink-soft); font-size: 0.95rem; line-height: 1.5; }
  .e-todo {
    color: var(--ink-faint);
    background: #fef2f2;
    border-left: 2px solid var(--red);
    padding: 0.3rem 0.7rem;
    align-self: start;
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .contact { margin-top: 2.5rem; }

  @media (max-width: 560px) {
    .entry { grid-template-columns: 1fr; gap: 0.4rem; }
    .year { padding-top: 0; }
  }
</style>
