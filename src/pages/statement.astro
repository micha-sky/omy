---
import Base from "../layouts/Base.astro";

// Who / What / Why — built on OMy's line:
// "I tune my antennas to get insight and transmutate,
//  to remind us all that we are one — OM."
const movements = [
  {
    w: "Who",
    text:
      "I am an antenna. A guitarist who learned to listen — to a text, a body, a room — and to tune in to what is already sounding there.",
  },
  {
    w: "What",
    text:
      "I tune my antennas, get insight, and transmutate it — turning a living signal, an EEG, a plant, a room, into sound in real time.",
  },
  {
    w: "Why",
    html: true,
    text:
      "To remind us all that we were never separate — performer and machine, human and plant, you and I. We are one. <span style=\"color:#dc2626\">OM</span>.",
  },
];
---

<Base title="Oleksandr Mykhalskyi — Statement" active="Statement">
  <article class="statement wrap">
    <header class="st-head">
      <p class="eyebrow">Statement</p>
      <h1 class="display distort">We are&nbsp;one.</h1>
    </header>

    <div class="movements">
      {movements.map((m) => (
        <section class="movement">
          <p class="mv-label mono">{m.w}</p>
          {m.html
            ? <p class="mv-text display distort-light" set:html={m.text} />
            : <p class="mv-text display distort-light">{m.text}</p>}
        </section>
      ))}
    </div>

    <p class="sig mono">Oleksandr Mykhalskyi · Kalush → Hamburg</p>
  </article>
</Base>

<style>
  .statement { padding-top: 3rem; padding-bottom: 4rem; }
  .st-head { margin-bottom: 3.5rem; }
  .st-head .eyebrow { display: block; margin-bottom: 1.2rem; }

  .movements {
    display: flex;
    flex-direction: column;
    gap: 2.8rem;
    max-width: 46rem;
  }
  .movement {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1.5rem;
    align-items: baseline;
  }
  .mv-label {
    color: var(--red);
    letter-spacing: 0.2em;
    padding-top: 0.5rem;
  }
  .mv-text {
    font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.4rem);
    line-height: 1.12;
    margin: 0;
  }
  .mv-text .om {
    color: var(--red);
    font-weight: 400;
  }

  .sig { margin-top: 3.5rem; color: var(--ink-faint); }

  @media (max-width: 560px) {
    .movement { grid-template-columns: 1fr; gap: 0.5rem; }
    .mv-label { padding-top: 0; }
  }
</style>
